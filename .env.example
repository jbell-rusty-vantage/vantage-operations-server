# Same Atlas connection and production database as vantage-main-server.
# Supply values yourself; no credentials are copied from the existing server.
MONGO_URI=
TEST_MODE=false
# Used only when TEST_MODE=true; must never be vantagemovers.
TEST_MONGO_DATABASE_NAME=testvantagemovers
# Optional comma-separated DNS servers for Atlas SRV lookup.
MONGO_DNS_SERVERS=

# Server-to-server only. Never distribute this in the browser extension.
VANTAGE_API_SECRET=
# Exact comma-separated origins. Empty disables browser CORS grants.
CORS_ALLOWED_ORIGINS=
PORT=3001
LOG_LEVEL=info
