diff --git a/ops/local-extension-smoke.mjs b/ops/local-extension-smoke.mjs
new file mode 100644
index 0000000..63aef7f
--- /dev/null
+++ b/ops/local-extension-smoke.mjs
@@ -0,0 +1,51 @@
+// Developer-only: fresh isolated profile, synthetic DOM, read-only messages.
+// Requires `pnpm build` and Playwright (PLAYWRIGHT_MODULE may select its package).
+import assert from 'node:assert/strict';
+import { createServer } from 'node:http';
+import { readFile, mkdtemp } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join, resolve } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const root = fileURLToPath(new URL('../', import.meta.url));
+const moduleName = process.env.PLAYWRIGHT_MODULE || 'playwright';
+const { chromium } = await import(moduleName.startsWith('.') || /^[A-Z]:/i.test(moduleName)
+  ? pathToFileURL(resolve(moduleName)).href : moduleName);
+const fixture = await readFile(new URL('./local-fixture.html', import.meta.url));
+const server = createServer((_request, response) => {
+  response.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
+  response.end(fixture);
+});
+await new Promise(resolve => server.listen(3411, '127.0.0.1', resolve));
+const profile = await mkdtemp(join(tmpdir(), 'granot-extension-local-'));
+const extension = join(root, '.output', 'chrome-mv3');
+const context = await chromium.launchPersistentContext(profile, {
+  headless: false,
+  executablePath: process.env.GRANOT_CHROMIUM_PATH || undefined,
+  args: [`--disable-extensions-except=${extension}`, `--load-extension=${extension}`, '--remote-debugging-port=9223', '--remote-debugging-address=127.0.0.1'],
+});
+try {
+  const worker = context.serviceWorkers()[0] || await context.waitForEvent('serviceworker');
+  const page = await context.newPage();
+  await page.goto('http://localhost:3411/mpcharge~chargeswc');
+  const result = await worker.evaluate(async () => {
+    const [tab] = await chrome.tabs.query({ url: 'http://localhost:3411/*' });
+    const ping = await chrome.tabs.sendMessage(tab.id, { type: 'PING' });
+    const parsed = await chrome.tabs.sendMessage(tab.id, { type: 'PARSE_TARIFF_ADJUSTMENT' });
+    return { pingOk: ping.ok, pageFound: parsed.pageFound, missing: parsed.missing, located: parsed.located };
+  });
+  assert.equal(result.pingOk, true);
+  assert.equal(result.pageFound, true);
+  assert.deepEqual(result.missing, []);
+  assert.equal(result.located.linehaulCubicFeet, 450);
+  assert.equal(result.located.pickupZone, '00501');
+  assert.equal(result.located.deliveryZone, '33101');
+  console.log(JSON.stringify({ ok: true, cdp: 'http://127.0.0.1:9223', profile, result }, null, 2));
+  if (process.argv.includes('--keep-open')) {
+    console.log('Browser retained for the developer. Ctrl+C closes this isolated browser and fixture server.');
+    await new Promise(resolve => process.once('SIGINT', resolve));
+  }
+} finally {
+  await context.close();
+  server.close();
+}
diff --git a/ops/granot-browser-readiness.mjs b/ops/granot-browser-readiness.mjs
new file mode 100644
index 0000000..311ad70
--- /dev/null
+++ b/ops/granot-browser-readiness.mjs
@@ -0,0 +1,119 @@
+// Developer-only readiness checks. Never print page data, URLs, credentials or raw errors.
+import { readFile } from 'node:fs/promises';
+import { resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { parseEnv } from 'node:util';
+
+const inspect = process.argv.includes('--inspect-current-job');
+const live = process.argv.includes('--live');
+let browser;
+try {
+  if (inspect && live) throw new Error('Choose one mode');
+  const moduleName = process.env.PLAYWRIGHT_MODULE || 'playwright';
+  const { chromium } = await import(/^[A-Z]:/i.test(moduleName) || moduleName.startsWith('.')
+    ? pathToFileURL(resolve(moduleName)).href : moduleName);
+  // Fixed loopback endpoint: do not send browser/session access to external hosts.
+  browser = await chromium.connectOverCDP('http://127.0.0.1:9223');
+  const context = browser.contexts()[0];
+  if (!context) throw new Error('No browser context');
+  const worker = context.serviceWorkers().find(worker => worker.url().startsWith('chrome-extension://'));
+  if (!worker) throw new Error('Extension service worker unavailable');
+  let page;
+  let selectedTabId;
+  if (inspect) {
+    const candidates = [];
+    for (const candidate of context.pages()) {
+      if (!candidate.url().startsWith('https://eagle.hellomoving.com/')) continue;
+      if (await candidate.locator('form[name="theForm"] input[name="I1PERCFLBS"]').count()) candidates.push(candidate);
+    }
+    if (candidates.length !== 1) throw new Error('Expected exactly one supported job');
+    page = candidates[0];
+  } else if (live) {
+    const envPath = process.env.GRANOT_CREDENTIALS_FILE || resolve('../agent_granot_credentials/.env');
+    const raw = await readFile(envPath, 'utf8');
+    const values = Object.fromEntries(Object.entries(parseEnv(raw)).filter(([name]) => /^(GRANOT_|MAIN_LOGIN|SPECIFIC)/.test(name)));
+    const get = (...names) => names.map(name => process.env[name] || values[name]).find(Boolean);
+    const networkUser = get('GRANOT_NETWORK_USERNAME', 'GRANOT_NETWORK_USER', 'MAIN_LOGIN_USERNAME', 'MAIN_LOGIN_USER');
+    const networkPassword = get('GRANOT_NETWORK_PASSWORD', 'MAIN_LOGIN_PASSWORD');
+    const user = get('GRANOT_USERNAME', 'GRANOT_USER', 'SPECIFIC_USERNAME', 'SPECIFIC_USER');
+    const password = get('GRANOT_PASSWORD', 'SPECIFIC_PASSWORD');
+    if (![networkUser, networkPassword, user, password].every(Boolean)) throw new Error('Required credential aliases missing');
+    page = await context.newPage();
+    // Capture this exact new tab before Granot's shared frameset URL duplicates
+    // an existing signed-in tab. URL-first selection after login is ambiguous.
+    await page.goto(`http://localhost:3411/mpcharge~chargeswc#live-readiness-${crypto.randomUUID()}`);
+    selectedTabId = await worker.evaluate(async url => {
+      const matches = (await chrome.tabs.query({})).filter(tab => tab.url === url);
+      if (matches.length !== 1) throw new Error('Ambiguous new tab');
+      return matches[0].id;
+    }, page.url());
+    await page.goto('https://eagle.hellomoving.com/vantage/admin.htm');
+    const loginFrame = await new Promise((resolve, reject) => {
+      const deadline = Date.now() + 15000;
+      const timer = setInterval(async () => {
+        try {
+          for (const frame of page.frames()) {
+            if (await frame.locator('input[name="LOGON_USER"]').count()) {
+              clearInterval(timer); resolve(frame); return;
+            }
+          }
+          if (Date.now() > deadline) { clearInterval(timer); reject(new Error('Login form unavailable')); }
+        } catch { clearInterval(timer); reject(new Error('Login form unavailable')); }
+      }, 100);
+    });
+    await loginFrame.locator('input[name="LOGON_USER"]').fill(networkUser);
+    await loginFrame.locator('input[name="PASSWORD"]').fill(networkPassword);
+    const save = loginFrame.locator('input[name="SAVEPASS"]');
+    if (await save.count()) await save.uncheck();
+    await loginFrame.locator('[name="LOGON"]').click();
+    await loginFrame.locator('input[name="USERNAME"]').waitFor({ state: 'visible' });
+    await loginFrame.locator('input[name="USERNAME"]').fill(user);
+    await loginFrame.locator('input[name="PASSWORD"]').fill(password);
+    await loginFrame.locator('[name="LOGON"]').click();
+    await loginFrame.locator('input[name="USERNAME"]').waitFor({ state: 'detached' });
+    // The outer frameset keeps its product title; Main Menu is the content frame.
+    await loginFrame.waitForFunction(() => document.title === 'Main Menu');
+  } else {
+    page = await context.newPage();
+    await page.goto(`http://localhost:3411/mpcharge~chargeswc#readiness-${crypto.randomUUID()}`);
+  }
+  // Use the exact selected tab only. Never return its URL or parser values.
+  const result = await worker.evaluate(async ({ url, inspect, live, selectedTabId }) => {
+    const tabs = await chrome.tabs.query({});
+    const candidates = tabs.filter(tab => tab.url === url && (selectedTabId === undefined || tab.id === selectedTabId));
+    if (candidates.length !== 1) throw new Error('Ambiguous target tab');
+    const id = candidates[0].id;
+    const ping = await chrome.tabs.sendMessage(id, { type: 'PING' });
+    if (live) return { extensionPing: ping.ok === true };
+    const parsed = await chrome.tabs.sendMessage(id, { type: 'PARSE_TARIFF_ADJUSTMENT' });
+    return {
+      extensionPing: ping.ok === true,
+      formFound: parsed.pageFound === true,
+      actualCf: typeof parsed.located?.linehaulCubicFeet === 'number',
+      pickupZip: Boolean(parsed.located?.pickupZone),
+      deliveryZip: Boolean(parsed.located?.deliveryZone),
+    };
+  }, { url: page.url(), inspect, live, selectedTabId });
+  if (inspect) {
+    result.dom = await page.evaluate(() => {
+      const normalize = value => (value || '').replace(/\u00a0/g, ' ').replace(/\s+/g, ' ').trim();
+      const cells = [...document.querySelectorAll('td.FROMTO')].filter(cell => !cell.querySelector('td'));
+      const locations = cells.filter(cell => /,\s*[A-Z]{2}\s+\d{5}(?:-\d{4})?\b/.test(normalize(cell.textContent)));
+      return {
+        form: document.querySelectorAll('form[name="theForm"]').length === 1,
+        mileage: [...document.querySelectorAll('td.TD2')].some(cell => /^Distance:\s*\d+(?:\.\d+)?\s*Miles$/i.test(normalize(cell.textContent))),
+        stateZipPairs: locations.length === 2,
+      };
+    });
+  }
+  if (!Object.values(result).filter(value => typeof value === 'boolean').every(Boolean)) throw new Error('Readiness check failed');
+  if (inspect && !Object.values(result.dom).every(Boolean)) throw new Error('DOM readiness check failed');
+  console.log(JSON.stringify({ ok: true, mode: inspect ? 'current-job-read-only' : live ? 'live-login' : 'synthetic', ...result }));
+  if (!inspect && !live) await page.close();
+} catch {
+  console.error(JSON.stringify({ ok: false, error: 'READINESS_FAILED', guidance: 'Check browser/fixture ports, extension loading, supported job selection or credential aliases. No page data or raw error was logged.' }));
+  process.exitCode = 1;
+} finally {
+  // CDP disconnect only; preserve the developer browser and all existing tabs.
+  if (browser) await browser.close();
+}
